# Copy this file to .env and fill in your values. Never commit .env.

# PostgreSQL with the pgvector extension (Neon: https://neon.tech)
# Use the connection string exactly as the provider shows it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key

# ---- Optional ----
# GEMINI_MODEL=gemini-3.6-flash
# RATE_LIMIT_REQUESTS=5
# RATE_LIMIT_WINDOW_SECONDS=600
# MAX_UPLOAD_MB=5
# ALLOWED_ORIGINS=https://my-frontend.example.com
# AUTO_INIT_DB=1
# LOG_LEVEL=INFO
